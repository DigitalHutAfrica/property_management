<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_rejection_wizard_view" model="ir.ui.view">
        <field name="name">maintenance.rejection.wizard.form</field>
        <field name="model">maintenance.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Maintenance Request">
                <div class="alert alert-warning mb-3">
                    <strong>⚠ You are about to reject this maintenance request.</strong>
                    A rejection reason is mandatory and will be sent to the requestor.
                </div>
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="reason" placeholder="Enter rejection reason…" required="1"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object"
                            string="Confirm Rejection" class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
